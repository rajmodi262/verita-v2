# Copy to .env for local development. Never commit .env.
VERITA_ENV=dev
VERITA_DATABASE_URL=sqlite+pysqlite:///./verita-dev.sqlite
# VERITA_DATABASE_URL=postgresql+psycopg://verita:verita@localhost:5432/verita
VERITA_LOG_LEVEL=INFO
VERITA_CORS_ORIGINS=["http://localhost:5173"]
VERITA_SESSION_TTL_MINUTES=480

# Demo users (uv run verita users seed-demo). If unset, a random password is printed once.
# VERITA_DEMO_PASSWORD=

# LLM providers. Leave empty to use the offline template generator.
# Key pools, comma-separated in priority order: the first key with quota is used, and an
# exhausted key is skipped immediately until its retry time. Check them: uv run verita llm keys
# VERITA_GEMINI_API_KEYS=key1,key2,key3
# VERITA_GROQ_API_KEYS=key1
# A single key per provider still works (used only when the pool is empty):
# GEMINI_API_KEY=
# GROQ_API_KEY=
