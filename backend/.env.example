# Copy to .env for local development. Never commit .env.
VERITA_ENV=dev
VERITA_DATABASE_URL=sqlite+pysqlite:///./verita-dev.sqlite
# VERITA_DATABASE_URL=postgresql+psycopg://verita:verita@localhost:5432/verita
VERITA_LOG_LEVEL=INFO
VERITA_CORS_ORIGINS=["http://localhost:5173"]
VERITA_SESSION_TTL_MINUTES=480

# Demo users (uv run verita users seed-demo). If unset, a random password is printed once.
# VERITA_DEMO_PASSWORD=

# LLM providers (M6). Leave empty to use the offline template generator.
# GEMINI_API_KEY=
# GROQ_API_KEY=
