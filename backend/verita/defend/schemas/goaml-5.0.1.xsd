<xs:schema xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xerces="http://xerces.apache.org" xmlns:goaml="http://www.unodc.org/goaml" id="report" goaml:appVersion="5.0" vc:minVersion="1.1" goaml:schemaVersion="5.0.1">
  <xs:element name="report">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rentity_id">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="rentity_branch" minOccurs="0" maxOccurs="0">
          <!--added maxOccurs=0-->
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="0" />
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="submission_code" type="submission_type" />
        <xs:element name="report_code" type="report_type" />
        <xs:element name="entity_reference">
          <!--removed minOccurs="0"-->
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="fiu_ref_number" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:choice>
          <xs:element name="submission_date" type="sql_date">
            <xs:annotation>
              <xs:documentation>The element will be deprecated in Schema 6. Please consider using report_date instead of submission_date.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="report_date" type="sql_date" goaml:supportedIn="5.0" />
        </xs:choice>
        <xs:element name="currency_code_local" type="currency_type" fixed="EUR" />
        <xs:choice minOccurs="0">
          <xs:element name="reporting_person" type="t_person_registration_in_report" />
        </xs:choice>
        <xs:element name="location" type="t_address" minOccurs="0" maxOccurs="0" />
        <!--added maxOccurs="0" -->
        <xs:element name="reason" type="comments_type" minOccurs="0" />
        <xs:element name="action" type="comments_type" minOccurs="0" />
        <xs:choice>
          <xs:sequence>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="transaction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="transactionnumber">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                          <xs:minLength value="1" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="internal_ref_number" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1" />
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_location" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="0" />
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_description" type="comments_type" minOccurs="0" />
                    <xs:element name="date_transaction" type="sql_date" />
                    <xs:element name="teller" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="authorized" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:sequence minOccurs="0" maxOccurs="0">
                      <!--added maxOccurs="0"-->
                      <xs:element name="late_deposit" minOccurs="0" maxOccurs="0">
                        <!--added minOccurs="0" maxOccurs="0"-->
                        <xs:complexType>
                          <xs:simpleContent>
                            <xs:extension base="xs:boolean" />
                          </xs:simpleContent>
                        </xs:complexType>
                      </xs:element>
                      <xs:element name="date_posting" type="sql_date" minOccurs="0" maxOccurs="0" />
                      <!--added minOccurs="0" maxOccurs="0"-->
                    </xs:sequence>
                    <xs:element name="value_date" type="sql_date" minOccurs="0" />
                    <xs:element name="transmode_code" type="conduction_type" />
                    <xs:element name="transmode_comment" minOccurs="0" maxOccurs="0">
                      <!--added maxOccurs="0"-->
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="amount_local">
                      <xs:simpleType>
                        <xs:restriction base="xs:decimal">
                          <xs:minInclusive value="0" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:choice>
                      <xs:element name="involved_parties">
                        <xs:complexType>
                          <xs:sequence maxOccurs="unbounded">
                            <xs:element name="party" type="t_party" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:sequence>
                        <xs:choice>
                          <xs:element name="t_from_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0" maxOccurs="0">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence>
                                  <xs:element name="t_conductor" type="t_person" minOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account_my_client" />
                                    <xs:element name="from_person" type="t_person_my_client" />
                                    <xs:element name="from_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_from">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0" maxOccurs="0">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence>
                                  <xs:element name="t_conductor" type="t_person" minOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account" />
                                    <xs:element name="from_person" type="t_person" />
                                    <xs:element name="from_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                        <xs:choice>
                          <xs:element name="t_to_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0" maxOccurs="0">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence>
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account_my_client" />
                                    <xs:element name="to_person" type="t_person_my_client" />
                                    <xs:element name="to_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_to">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0" maxOccurs="0">
                                  <!--added maxOccurs="0"-->
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" minOccurs="0" />
                                <xs:sequence>
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account" />
                                    <xs:element name="to_person" type="t_person" />
                                    <xs:element name="to_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:sequence>
                    </xs:choice>
                    <xs:element name="goods_services" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="item" type="t_trans_item" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="comments" type="comments_type" minOccurs="0" />
                  </xs:sequence>
                  <!-- Assert added by CRF: Transfers can only be between accounts -->
                  <xs:assert test="(if (concat(t_from/from_funds_code,t_from_my_client/from_funds_code) eq 'Q') then ((t_from/from_account) or (t_from_my_client/from_account)) else true())            and (if (concat(t_to/to_funds_code,t_to_my_client/to_funds_code) eq 'Q') then ((t_to/to_account) or (t_to_my_client/to_account)) else true())" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS03: If the transaction type is Transfer, then both sides of the transaction must be accounts.&lt;/b&gt;&lt;br/&gt;            &lt;i&gt;REJ-TRS03: Si le type de transaction est Virement, alors les deux côtés de la transaction doivent être des comptes.&lt;/i&gt;&lt;br/&gt;            &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
                  <!-- Assert added by CRF: A transaction is the same type for 'to' and 'from' sides, funds_codes should always match -->
                  <xs:assert test="concat(t_from/from_funds_code,t_from_my_client/from_funds_code) eq concat(t_to/to_funds_code,t_to_my_client/to_funds_code)" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS04: Transaction type (funds_code) must be the same for 'from' and 'to' sides.&lt;/b&gt;&lt;br/&gt;            &lt;i&gt;REJ-TRS04: Le type de transaction (funds_code) doit être le même au débit qu'au crédit.&lt;/i&gt;&lt;br/&gt;            &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:element name="activity" type="activityType" minOccurs="0" goaml:supportedIn="5.0" />
          </xs:sequence>
          <xs:element name="activity" type="activityType" />
        </xs:choice>
        <xs:element name="report_indicators" minOccurs="0">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="indicator" type="report_indicator_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- asserts added by CRF -->
      <!--
	  
		Controls related to the reason field:
	-->
      <xs:assert test="if (boolean(reason)) then reason/node() else true()" xerces:message="REJ-REA01: Reason must not be empty.      REJ-REA01: Motivation ne doit pas être vide.      For more information, see our FAQ https://faq.goaml.lu/asserts/" />
      <xs:assert test="if (not(boolean(reason))) then ((report_code eq 'RIRA') or (report_code eq 'RIRT')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-REA02: Reason must be indicated, except if the report type is RIRA or RIRT.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-REA02: Motivation doit être renseignée, sauf si le type de déclaration est RIRA ou RIRT.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <!--
		Controls related to indicators:
	 -->
      <xs:assert test="if (not(boolean(report_indicators))) then ((report_code ne 'STR') and (report_code ne 'SAR') and (report_code ne 'STRe') and (report_code ne 'SARe') and (report_code ne 'TFTR') and (report_code ne 'TFAR')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-IND01: Indicators must be included, except if the report type is RIRA or RIRT.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-IND01: Indicateurs doivent être inclus, sauf si le type de déclaration est RIRA ou RIRT.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <!--
		Controls related to transactions:
	-->
      <xs:assert test="count(transaction/transactionnumber) eq count(distinct-values(transaction/transactionnumber))" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS01: Each transaction number in the report must be unique.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-TRS01: Chaque numéro de transaction dans la déclaration doit être unique.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
      <xs:assert test="count(transaction) lt 501" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-TRS02: The limit of transactions per report is set to 500.&lt;/b&gt;&lt;br/&gt;      &lt;i&gt;REJ-TRS02: La limite de transactions par déclaration est 500.&lt;/i&gt;&lt;br/&gt;      &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    </xs:complexType>
  </xs:element>
  <xs:complexType name="t_account_my_client">
    <xs:sequence>
      <xs:element name="institution_name" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="institution_code">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="swift">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="11" />
              <xs:minLength value="8" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:choice>
      <xs:element name="non_bank_institution" type="xs:boolean" minOccurs="0" />
      <xs:element name="branch" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="account">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="currency_code" type="currency_type" minOccurs="0" />
      <xs:element name="account_name">
        <!--removed minOccurs="0"-->
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="iban" type="iban_type" minOccurs="0" />
      <xs:element name="client_number" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="30" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice minOccurs="0">
        <xs:element name="personal_account_type" type="account_type" />
      </xs:choice>
      <xs:element name="t_entity" type="t_entity_my_client" minOccurs="0" />
      <xs:choice>
        <xs:element name="signatory" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="is_primary" fixed="1" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:boolean" />
                </xs:simpleType>
              </xs:element>
              <xs:element name="t_person" type="t_person_my_client" />
              <xs:element name="role" type="account_person_role_type" />
              <!--removed minOccurs="0" -->
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="opened" type="sql_date" minOccurs="0" />
      <xs:element name="closed" type="sql_date" minOccurs="0" />
      <xs:sequence minOccurs="0">
        <xs:element name="balance" type="xs:decimal" minOccurs="1" />
        <xs:element name="date_balance" type="sql_date" minOccurs="1" />
      </xs:sequence>
      <xs:sequence minOccurs="0">
        <xs:element name="status_code" type="account_status_type" />
      </xs:sequence>
      <xs:element name="beneficiary" minOccurs="0" maxOccurs="0">
        <!--added maxOccurs="0"-->
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="beneficiary_comment" minOccurs="0" maxOccurs="0">
        <!--added maxOccurs="0"-->
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="comments" type="comments_type" minOccurs="0" maxOccurs="0" />
      <!--added maxOccurs="0"-->
    </xs:sequence>
    <!--
			CRF-added assert 
			to make sure IBAN account numbers are correctly filled out:
		-->
    <xs:assert test="if (iban) then (matches(iban , '^([A-Z]{2}\d{2}[A-Z0-9]{10,30})$')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-IBAN01: an IBAN number is not correctly formatted.&lt;/b&gt;&lt;br/&gt;       &lt;i&gt;REJ-IBAN01: un IBAN n'est pas formaté correctement.&lt;/i&gt;&lt;br/&gt;       &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    <xs:assert test="if (iban) then (iban eq account) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-ACC01: If an IBAN number is present, the account number must be identical to the IBAN.&lt;/b&gt;&lt;br/&gt;       &lt;i&gt;REJ-ACC01: Si un IBAN est renseigné, le numéro de compte doit être identique à l'IBAN.&lt;/i&gt;&lt;br/&gt;       &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    <xs:assert test="if (iban) then (swift) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-ACC02: If an IBAN number is present, then a BIC/SWIFT code should be provided, not an institution_code.&lt;/b&gt;&lt;br/&gt;       &lt;i&gt;REJ-ACC02: Si un IBAN est présent, alors il faut renseigner un SWIFT, pas un identifiant (institution_code).&lt;/i&gt;&lt;br/&gt;       &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    <!--The SWIFT or BIC code has the form of 8 or 11 characters: 
			- 4 alphanum (business party prefix),
			- 2 alpha (country code) 
			- 2 alphanum (business party suffix), 
			optionally followed by 3 characters specifiying a branch. -->
    <xs:assert test="if (swift) then (matches(swift , '^([A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}|[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{5})$')) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-BIC01: BIC/SWIFT code is not correctly formatted.&lt;/b&gt;&lt;br/&gt;       &lt;i&gt;REJ-BIC01: un BIC/SWIFT n'est pas correctement formaté.&lt;/i&gt;&lt;br/&gt;       &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    <xs:assert test="if (string-length(swift) = 11) then (branch eq swift) else true()" xerces:message="&lt;br/&gt;&lt;b&gt;REJ-ACC03: If the SWIFT is 11 chars long (thus, indicates a branch), branch must be filled out and contain the same 11 char-SWIFT.&lt;/b&gt;&lt;br/&gt;       &lt;i&gt;REJ-ACC03: Si le SWIFT a 11 caractères (indiquant une succursale), succursale (branch) doit être renseigné et contenir le même SWIFT de 11 caractères.&lt;/i&gt;&lt;br/&gt;       &lt;a href=&quot;https://faq.goaml.lu/asserts/&quot; target=&quot; _blank&quot;&gt;For more information, see our FAQ&lt;/a&gt;&lt;br/&gt;&lt;br/&gt;" />
    <!--Institution names, because of the variety of spellings, hinder the automatic merge process integrated in goAML and should therefore be omitted if a banking institution is identified by its institution (or Swift) code-->
