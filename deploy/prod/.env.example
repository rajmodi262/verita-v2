# Copy to deploy/prod/.env (git-ignored) and fill in. Never commit real values.
VERITA_DOMAIN=verita.example.org
VERITA_REGISTRY=ghcr.io/OWNER
VERITA_TAG=v1.0.0
POSTGRES_PASSWORD=
VERITA_APP_DB_PASSWORD=
# Optional LLM drafting; leave the key pools empty for offline drafting only.
# Comma-separated, in priority order; an exhausted key is skipped at once until it resets.
VERITA_LLM_PROVIDERS=["gemini","groq"]
VERITA_GEMINI_API_KEYS=
VERITA_GROQ_API_KEYS=
